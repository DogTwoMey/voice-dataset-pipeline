{
  "$defs": {
    "BundleAssets": {
      "additionalProperties": false,
      "properties": {
        "gpt": {
          "$ref": "#/$defs/BundleFile"
        },
        "sovits": {
          "$ref": "#/$defs/BundleFile"
        }
      },
      "required": [
        "gpt",
        "sovits"
      ],
      "title": "BundleAssets",
      "type": "object"
    },
    "BundleDistribution": {
      "additionalProperties": false,
      "properties": {
        "model_allowed": {
          "title": "Model Allowed",
          "type": "boolean"
        },
        "reference_audio_allowed": {
          "title": "Reference Audio Allowed",
          "type": "boolean"
        },
        "source_dataset_included": {
          "const": false,
          "title": "Source Dataset Included",
          "type": "boolean"
        }
      },
      "required": [
        "model_allowed",
        "reference_audio_allowed",
        "source_dataset_included"
      ],
      "title": "BundleDistribution",
      "type": "object"
    },
    "BundleEngine": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "gpt-sovits",
          "title": "Name",
          "type": "string"
        },
        "api": {
          "const": "api_v2",
          "title": "Api",
          "type": "string"
        },
        "model_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "api",
        "model_version"
      ],
      "title": "BundleEngine",
      "type": "object"
    },
    "BundleFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "BundleFile",
      "type": "object"
    },
    "BundleProvenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/CodeProvenance"
        },
        "pipeline": {
          "$ref": "#/$defs/CodeProvenance"
        },
        "dataset": {
          "$ref": "#/$defs/DatasetProvenance"
        },
        "training": {
          "$ref": "#/$defs/TrainingProvenance"
        },
        "selection": {
          "$ref": "#/$defs/SelectionProvenance"
        }
      },
      "required": [
        "provider",
        "pipeline",
        "dataset",
        "training",
        "selection"
      ],
      "title": "BundleProvenance",
      "type": "object"
    },
    "BundleReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "auto_enabled": {
          "title": "Auto Enabled",
          "type": "boolean"
        },
        "audio": {
          "title": "Audio",
          "type": "string"
        },
        "prompt_text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Prompt Text",
          "type": "string"
        },
        "prompt_lang": {
          "enum": [
            "zh",
            "ja",
            "en",
            "ko",
            "yue"
          ],
          "title": "Prompt Lang",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "auto_enabled",
        "audio",
        "prompt_text",
        "prompt_lang",
        "sha256",
        "bytes"
      ],
      "title": "BundleReference",
      "type": "object"
    },
    "BundleReferences": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "title": "Default"
        },
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/BundleReference"
          },
          "title": "Items",
          "type": "object"
        }
      },
      "required": [
        "default",
        "items"
      ],
      "title": "BundleReferences",
      "type": "object"
    },
    "BundleRights": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Attestation Id",
          "type": "string"
        },
        "attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attestation Sha256",
          "type": "string"
        },
        "dataset_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Fingerprint",
          "type": "string"
        },
        "training_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Training Plan Fingerprint",
          "type": "string"
        },
        "rights_basis": {
          "enum": [
            "self_recorded",
            "licensed",
            "public_domain",
            "explicit_permission"
          ],
          "title": "Rights Basis",
          "type": "string"
        },
        "voice_subject_authorization": {
          "enum": [
            "self",
            "explicit_permission",
            "not_applicable"
          ],
          "title": "Voice Subject Authorization",
          "type": "string"
        },
        "training_allowed": {
          "const": true,
          "title": "Training Allowed",
          "type": "boolean"
        },
        "local_inference_allowed": {
          "const": true,
          "title": "Local Inference Allowed",
          "type": "boolean"
        },
        "model_distribution_allowed": {
          "title": "Model Distribution Allowed",
          "type": "boolean"
        },
        "reference_audio_distribution_allowed": {
          "title": "Reference Audio Distribution Allowed",
          "type": "boolean"
        },
        "source_dataset_included": {
          "const": false,
          "title": "Source Dataset Included",
          "type": "boolean"
        }
      },
      "required": [
        "attestation_id",
        "attestation_sha256",
        "dataset_fingerprint",
        "training_plan_fingerprint",
        "rights_basis",
        "voice_subject_authorization",
        "training_allowed",
        "local_inference_allowed",
        "model_distribution_allowed",
        "reference_audio_distribution_allowed",
        "source_dataset_included"
      ],
      "title": "BundleRights",
      "type": "object"
    },
    "CodeProvenance": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "dirty_diff_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty Diff Sha256"
        },
        "source_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "source_snapshot_sha256"
      ],
      "title": "CodeProvenance",
      "type": "object"
    },
    "DatasetProvenance": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "metadata_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metadata Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "dataset_list_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset List Sha256",
          "type": "string"
        },
        "included_items": {
          "exclusiveMinimum": 0,
          "title": "Included Items",
          "type": "integer"
        },
        "reviewed_only": {
          "title": "Reviewed Only",
          "type": "boolean"
        }
      },
      "required": [
        "fingerprint",
        "metadata_sha256",
        "manifest_sha256",
        "dataset_list_sha256",
        "included_items",
        "reviewed_only"
      ],
      "title": "DatasetProvenance",
      "type": "object"
    },
    "SelectionProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "method": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "training_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Training Plan Fingerprint",
          "type": "string"
        },
        "gpt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gpt Sha256",
          "type": "string"
        },
        "sovits_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sovits Sha256",
          "type": "string"
        },
        "evaluation_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Fingerprint"
        }
      },
      "required": [
        "source_sha256",
        "method",
        "training_plan_fingerprint",
        "gpt_sha256",
        "sovits_sha256"
      ],
      "title": "SelectionProvenance",
      "type": "object"
    },
    "TrainingProvenance": {
      "additionalProperties": false,
      "properties": {
        "plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Fingerprint",
          "type": "string"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "artifacts_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifacts Sha256"
        }
      },
      "required": [
        "plan_fingerprint",
        "plan_sha256"
      ],
      "title": "TrainingProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "插件与训练器共享的严格 voice-bundle v2 schema。",
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "bundle_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "title": "Bundle Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "engine": {
      "$ref": "#/$defs/BundleEngine"
    },
    "assets": {
      "$ref": "#/$defs/BundleAssets"
    },
    "references": {
      "$ref": "#/$defs/BundleReferences"
    },
    "provenance": {
      "$ref": "#/$defs/BundleProvenance"
    },
    "rights": {
      "$ref": "#/$defs/BundleRights"
    },
    "distribution": {
      "$ref": "#/$defs/BundleDistribution"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BundleFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "display_name",
    "engine",
    "assets",
    "references",
    "provenance",
    "rights",
    "distribution",
    "files"
  ],
  "title": "VoiceBundleManifest",
  "type": "object"
}

